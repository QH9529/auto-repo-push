{
  "default_repo": "your-username/your-repo",
  "default_branch": "main",
  "default_message": "Auto upload",
  "safe_mode": true,
  "exclude_patterns": [
    ".git/",
    ".gitignore",
    "__pycache__/",
    "*.pyc",
    ".DS_Store",
    "Thumbs.db",
    ".env",
    "*.pem",
    "*.key",
    "id_rsa",
    "id_ed25519",
    "secrets.json",
    "config.json",
    "*.zip",
    "*.tar",
    "*.tar.gz",
    "*.exe",
    "*.dll",
    "*.so",
    "node_modules/",
    "vendor/",
    "dist/",
    "build/",
    "*.log",
    "*.tmp"
  ],
  "auto_create_gitignore": true,
  "auto_init_repo": true,
  "auto_configure_remote": true,
  "push_cooldown_seconds": 180,
  "max_commits_per_hour": 100,
  "max_pushes_per_hour": 50
}